# Dedicated MVS configuration file. Override values here to avoid touching app/config.yaml.
PATCHMATCH_ITERATIONS: 10
PATCHMATCH_PATCH_SIZE: 7
ZNCC_EPSILON: 1e-6
TOP_K_COSTS: 5
PATCHMATCH_VANILLA_MIN_DEPTH: 7.5
PATCHMATCH_VANILLA_MAX_DEPTH: 35.0
PATCHMATCH_VANILLA_INITIAL_SEARCH_RANGE: 50.0
DEBUG_VISUALIZATION: true
DEBUG_SAVE_DEPTH_MAPS: true
DEBUG_SAVE_NORMAL_MAPS: false
# Optional: process only these (local) indices for the current dataset.
TARGET_INDICES: []

# Optional (name-free): apply TARGET_INDICES only to the N-th selected dataset in multi-dataset runs.
# - 1 means "first selected dataset", 2 means "second", ...
# - null disables this behavior (TARGET_INDICES applies to all datasets as before).
TARGET_DATASET_ORDINAL: null
MAX_NEIGHBORS: 8
STREAMING_VIEWER: false
# 点群を表示するかどうか（falseにすると表示されない）
SHOW_POINT_CLOUD: false
VIEWER_TOPDOWN_FRONT: [0.0, -1.0, 0.0]
VIEWER_TOPDOWN_UP: [0.0, 0.0, 1.0]
VIEWER_TOPDOWN_ZOOM: 0.7
VIEWER_ROLL_DEG: -90.0
DEPTH_FUSION_ENABLE: false

# --- Frame selection / subsampling (to reduce redundant video frames for MVS) ---
# none: use all frames
# stride: use every N-th frame (FRAME_STRIDE)
# pose: keyframe selection based on camera pose change thresholds
FRAME_SELECTION_MODE: stride

# stride mode
FRAME_STRIDE: 15

# pose mode (units follow txt/left_camera_poses.csv)
# - KEYFRAME_MIN_TRANSLATION_M: select when camera moved this much (meters)
# - KEYFRAME_MIN_ROTATION_DEG: select when camera rotated this much (degrees)
# - KEYFRAME_MAX_FRAME_GAP: force-select at least every N frames (0 disables)
# - KEYFRAME_MIN_FRAME_GAP: don't select frames closer than this gap unless forced
KEYFRAME_MIN_TRANSLATION_M: 1.5
KEYFRAME_MIN_ROTATION_DEG: 5.0
KEYFRAME_MAX_FRAME_GAP: 30
KEYFRAME_MIN_FRAME_GAP: 1

# Optional clamp for frame indices (inclusive). null means no clamp.
KEYFRAME_START_INDEX: null
KEYFRAME_END_INDEX: null

# When frames are subsampled, neighbor views are chosen from adjacent selected keyframes.
# This controls how many neighbors to take on each side of the reference view.
NEIGHBOR_KEYFRAMES_EACH_SIDE: 5

# --- Neighbor selection ---
# adjacent: (existing) pick neighbors adjacent in the selected-frame order
# nearest: pick the nearest frames by distance from the reference camera position
NEIGHBOR_SELECTION_MODE: nearest

# Neighbor pool source:
# local: only frames from the current dataset
# global_csv: use a global pool CSV (e.g. output/<group>/csv/global_selected_poses.csv) to allow cross-dataset neighbors
# auto: if a global pool CSV is available (set by CLI in multi-dataset runs), use it; otherwise fall back to local.
NEIGHBOR_POOL_MODE: auto

# nearest mode parameters (units follow left_camera_poses.csv; typically meters)
NEIGHBOR_NEAREST_COUNT: 10
NEIGHBOR_NEAREST_MIN_RADIUS_M: 0.0
NEIGHBOR_NEAREST_MAX_RADIUS_M: 1000000000.0

# Write out which frames (and file paths) are actually used after subsampling.
SAVE_SELECTED_FRAMES_CSV: true
SELECTED_FRAMES_CSV_NAME: selected_frames.csv
LOG_SELECTED_FRAMES_MAX: 10

# Plot and save camera pose trajectory for the selected frames.
SAVE_SELECTED_POSE_PLOT: true
SELECTED_POSE_PLOT_NAME: selected_camera_poses.png
# Plane to project: "xz" (top-down for Unity-like), "xy", "yz"
POSE_PLOT_PLANE: xz
# Draw direction arrows every N selected frames
POSE_PLOT_ARROW_STRIDE: 5
# Arrow length (plot units; increase if arrows look too small)
POSE_PLOT_ARROW_SCALE: 0.25

# --- Execution control / preview ---
# If true, stop after frame selection + CSV + plots (skip heavy MVS computation).
PREVIEW_ONLY: false

# --- GT per-view export (can be expensive) ---
# Export GT depth EXR -> per-view PNGs, but do it after selection.
EXPORT_GT_PER_VIEW_ENABLE: true
# If true, export only for target_indices (selected/subsampled) instead of all frames.
EXPORT_GT_PER_VIEW_ONLY_TARGET: true
CHOICED_PROPAGATION_METHOD: checkerboard
PATCHMATCH_DECAY_RATE: 0.90
PATCHMATCH_NORMAL_SEARCH_ANGLE: 20.0
ADAPTIVE_WEIGHT_SIGMA_COLOR: 10
BUCKET_PROPAGATION_BINS: 4
FILTERING_COLOR_DIFFERENCE_THRESHOLD: 20
FILTERING_MIN_CONSISTENT_VIEWS: 3
GEOMETRIC_FILTER_ENABLED: false
GEOMETRIC_CONSISTENCY_ERROR_THRESHOLD: 0.05
GEOMETRIC_MIN_CONSISTENT_VIEWS: 2
POSITION_ERROR_SCALE: 0.0
ROTATION_ERROR_SCALE: 0.0
PROPAGATION_NEIGHBOR_DIRECTIONS: 4
USE_MEDIAN_TOP_K: 1
VIZ_DEPTH_MIN: 17.0
VIZ_DEPTH_MAX: 36.0
VIZ_CMAP: jet
# 複数のカメラ視点から生成された点群を使って、信頼性のある点群だけを残す
MULTI_VIEW_VISIBILITY_FILTER_ENABLED: true  # 現在、すべてのポイントが除外される問題があるため無効化
MULTI_VIEW_VISIBILITY_THRESHOLD: 2  # この数以上のビューから見える点だけを残す
MULTI_VIEW_GEOMETRIC_ERROR_THRESHOLD: 0.05  # 幾何学的エラーの閾値（相対深度差）
# エラーマップの可視化スケール（パーセンタイル）
# 95.0: 95パーセンタイルを使用（外れ値に引っ張られない、推奨）
# 99.0: 99パーセンタイルを使用（より多くの誤差を表示）
# 100.0: 最大値を使用（外れ値に引っ張られる可能性あり）
ERROR_MAP_PERCENTILE: 90.0
